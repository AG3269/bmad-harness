# Copy to .env for real Azure runs. Never commit .env.
AZURE_ENDPOINT=https://YOUR-PROJECT.openai.azure.com
AZURE_API_KEY=your_azure_api_key_here

# Azure deployment name, not necessarily the model name.
AZURE_MODEL_NAME=your-deployment-name
AZURE_API_VERSION=2025-04-01-preview

# Optional per-role deployment overrides.
# AZURE_READER_DEPLOYMENT=your_reader_deployment
# AZURE_COMPARER_DEPLOYMENT=your_comparer_deployment
# AZURE_DECIDER_DEPLOYMENT=your_decider_deployment
# AZURE_SUMMARIZER_DEPLOYMENT=your_summarizer_deployment

# For Azure AD authentication, remove AZURE_API_KEY and use azure.auth: aad.
